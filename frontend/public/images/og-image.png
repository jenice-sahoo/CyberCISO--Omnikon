<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0c4a6e;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#075985;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0369a1;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="shieldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#38bdf8;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#0ea5e9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0284c7;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="accentGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#7dd3fc;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#38bdf8;stop-opacity:1" />
    </linearGradient>
    <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="textGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGradient)"/>
  
  <!-- Decorative circuit lines -->
  <g stroke="#38bdf8" stroke-width="1" opacity="0.15" fill="none">
    <path d="M100 150 L200 150 L200 100"/>
    <path d="M1000 150 L1100 150 L1100 100"/>
    <path d="M100 480 L200 480 L200 530"/>
    <path d="M1000 480 L1100 480 L1100 530"/>
    <circle cx="150" cy="75" r="4" fill="#38bdf8" opacity="0.3"/>
    <circle cx="1050" cy="75" r="4" fill="#38bdf8" opacity="0.3"/>
    <circle cx="150" cy="555" r="4" fill="#38bdf8" opacity="0.3"/>
    <circle cx="1050" cy="555" r="4" fill="#38bdf8" opacity="0.3"/>
  </g>
  
  <!-- Main shield -->
  <path d="M600 80 L850 160 L850 380 C850 500 600 540 600 540 C600 540 350 500 350 380 L350 160 Z" 
        fill="url(#shieldGradient)" 
        stroke="url(#accentGradient)" 
        stroke-width="4"
        filter="url(#glow)"
        opacity="0.95"/>
  
  <!-- Inner shield highlight -->
  <path d="M600 130 L780 190 L780 350 C780 425 600 450 600 450 C600 450 420 425 420 350 L420 190 Z" 
        fill="none" 
        stroke="#7dd3fc" 
        stroke-width="3" 
        opacity="0.5"/>
  
  <!-- Lock icon -->
  <g transform="translate(600, 280)">
    <rect x="-45" y="20" width="90" height="65" rx="10" fill="#fff" opacity="0.95" filter="url(#glow)"/>
    <path d="M-32 20 C-32 -20 32 -20 32 20" fill="none" stroke="#0ea5e9" stroke-width="12" stroke-linecap="round"/>
    <circle cx="0" cy="52" r="10" fill="#0c4a6e"/>
    <rect x="-5" y="52" width="10" height="20" fill="#0c4a6e" rx="3"/>
  </g>
  
  <!-- Circuit accents on shield -->
  <g stroke="#7dd3fc" stroke-width="3" opacity="0.6" fill="none">
    <path d="M450 420 L500 420 L500 380"/>
    <path d="M700 420 L750 420 L750 380"/>
    <circle cx="475" cy="445" r="6" fill="#7dd3fc" opacity="0.7"/>
    <circle cx="725" cy="445" r="6" fill="#7dd3fc" opacity="0.7"/>
  </g>
  
  <!-- Title -->
  <text x="600" y="200" text-anchor="middle" font-family="system-ui, sans-serif" font-size="64" font-weight="800" fill="#fff" filter="url(#textGlow)" letter-spacing="4">CYBERCISO</text>
  
  <!-- Subtitle -->
  <text x="600" y="250" text-anchor="middle" font-family="system-ui, sans-serif" font-size="24" font-weight="400" fill="#bae6fd" letter-spacing="1">Virtual CISO for Small Business</text>
  
  <!-- Tagline -->
  <text x="600" y="520" text-anchor="middle" font-family="system-ui, sans-serif" font-size="20" font-weight="500" fill="#7dd3fc" opacity="0.9">NIST CSF 2.0 • CIS Controls v8 • 30-Day Remediation Plan</text>
  
  <!-- Bottom accent line -->
  <line x1="400" y1="560" x2="800" y2="560" stroke="url(#accentGradient)" stroke-width="3" opacity="0.6"/>
</svg>